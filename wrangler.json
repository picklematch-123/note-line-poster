{
  "name": "note-line-poster",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "note-line-poster",
      "database_id": "a1b41203-8b28-4b58-af74-5c5edd91634f",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d4923c79d64a454c9752726ac8c38ae4"
    }
  ],
  "workflows": [
    {
      "binding": "GENERATE",
      "name": "generate-article",
      "class_name": "GenerateArticleWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "*/15 * * * *"
    ]
  }
}
